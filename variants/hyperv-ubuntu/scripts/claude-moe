#!/usr/bin/env bash
# Start the themed Claude copy. After an official update it rebuilds the copy first;
# if that fails for any reason it starts the official Claude instead, so Claude always opens.
set -u
PREFIX="${CLAUDE_MOE_PREFIX:-$HOME/.local/share/claude-moe}"
OFFICIAL=/usr/lib/claude-desktop/claude-desktop
APP="$PREFIX/app/claude-desktop"

official() {
  printf 'claude-moe: %s; starting the official Claude\n' "$1" >&2
  shift
  exec "$OFFICIAL" "$@"
}

# claude-moe --wash 0.75 : set the background wash (0 to 0.95); a running themed Claude applies it at once.
if [ "${1:-}" = --wash ]; then
  exec python3 -I - "$PREFIX/config.json" "${2:-}" <<'EOF'
import json, sys
path, raw = sys.argv[1], sys.argv[2]
try:
    value = float(raw)
    if not 0 <= value <= 0.95: raise ValueError
except ValueError:
    sys.exit('claude-moe: --wash takes a number from 0 to 0.95, e.g. --wash 0.75')
try: config = json.load(open(path))
except (OSError, ValueError): config = {}
config['wash'] = round(value, 2)
with open(path + '.tmp', 'w') as f: f.write(json.dumps(config, indent=1) + '\n')
import os; os.replace(path + '.tmp', path)
print(f'claude-moe: wash set to {config["wash"]}')
EOF
fi

if [ ! -x "$OFFICIAL" ]; then
  echo 'claude-moe: the official Claude is not installed' >&2
  exit 1
fi
# A running copy only needs the arguments handed over (single instance); never rebuild under it.
if ! pgrep -f -- "^$APP( |\$)" >/dev/null 2>&1; then
  python3 -I "$PREFIX/lib/build.py" --prefix "$PREFIX" --quiet || official "rebuild failed" "$@"
fi
[ -x "$APP" ] || official "themed copy missing" "$@"
exec "$APP" "$@"
